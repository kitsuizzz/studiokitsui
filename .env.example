# Studio Kitsui — the app's own settings. Copy to .env and fill in.
# (.env is git-ignored; real environment variables always win over it.)

# --- the accounts database (MariaDB) ---------------------------------------
# The fused server keeps accounts, sessions and the end-to-end encrypted
# store here — one account for both halves of the app. The defaults match the
# docker compose stack of the upstream AI Studio checkout
# (`docker compose up -d mariadb`, published on 127.0.0.1:3306).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=aistudio
DB_PASSWORD=aistudio
DB_NAME=aistudio

# --- the platform model (the OpenAI-compatible upstream) --------------------
# The real provider key lives here, server-side; clients never see it.
# GATEWAY_MODELS=none exposes no platform models (BYOK only).
UPSTREAM_BASE_URL=http://127.0.0.1:9400/v1
UPSTREAM_API_KEY=
CONTEXT_TOKENS=
GATEWAY_MODELS=none

# --- who may call /chat/v1 --------------------------------------------------
# 1 (the default): signed-in accounts only — the platform model and its
# upstream key are not open to the network. 0: guests too (local dev).
# A GATEWAY_TOKEN, when set, locks /v1 to that bearer instead of sessions.
REQUIRE_SESSION=1
GATEWAY_TOKEN=

# --- the robot check on sign-ups -------------------------------------------
# off | test | live. "test" is Cloudflare's official test pair (any domain);
# only its documented test tokens pass. "live" needs a real site/secret pair.
TURNSTILE_MODE=test
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- the session cookie -----------------------------------------------------
COOKIE_SECURE=0
SESSION_TTL_DAYS=30

# --- keyless web search (the Chat agents' tools) ----------------------------
# A SearXNG the server can reach, or empty for the DuckDuckGo fallback.
SEARCH_PROVIDER=auto
SEARXNG_URL=

# --- the studio runner (the canvas execution backend) -----------------------
# Where runners dial in (loopback by default) and the shared token, when set.
# A remote runner must pass --token with the same value.
NNSTUDIO_RUNNER_TOKEN=
# NNSTUDIO_CHAT_WEB=/path/to/chat/frontend/dist  # move the Chat SPA build
