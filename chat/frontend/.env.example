# Copy to .env for local development (gitignored).
#
# The bot check's site key is NOT a build variable: there is one key, in the
# app's own .env (TURNSTILE_SITE_KEY), and both halves read it at runtime from
# GET /auth/config. See .env.example at the repository root.

# The platform gateway the app's server-provided model is called through.
# Default (unset): same-origin "/v1" (nginx in docker, the Vite proxy in dev).
# Point it at the bundled mock provider for the E2E gates/dev without a
# backend — the mock accepts any (or no) key:
VITE_PLATFORM_BASE_URL=http://127.0.0.1:9400/v1

# Optional: pin the default platform model instead of the first /v1/models id.
# VITE_PLATFORM_MODEL=
