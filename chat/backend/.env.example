# chat.kitsui gateway — local (non-docker) development.
# Copy to .env in this directory. The docker stack reads the repo-root .env instead.

# Any OpenAI-compatible base URL (the mock provider that ships with the repo):
UPSTREAM_BASE_URL=http://127.0.0.1:9400/v1
# The real provider's key (the mock ignores it).
UPSTREAM_API_KEY=

# Optional shared secret locking the gateway.
#   empty/unset  Open platform gateway: the browser calls /v1 directly (guests
#                included) for the platform-provided model.
#   set          Every /v1 request must present it as a bearer token; the app
#                then falls back to the per-user provider form (BYOK).
# Left empty here so local dev mirrors the docker stack's platform mode.
GATEWAY_TOKEN=

# Optional "model:tokens,..." map to fill in max_context_tokens when the
# upstream's /models/{id} endpoint doesn't publish it.
CONTEXT_TOKENS=

# Optional comma-separated allow-list of model ids exposed by /v1/models.
GATEWAY_MODELS=

# Comma-separated origins allowed to call this gateway cross-origin.
# Ships with https://chat.kitsui.co plus the local dev origins
# (localhost/127.0.0.1:1234), so "point the app at :8000" keeps working.
# Set empty to go wide open (*).
CORS_ORIGINS=https://chat.kitsui.co,http://localhost:1234,http://127.0.0.1:1234

# The accounts database (MariaDB). Start it from the repo root with
# `docker compose up -d mariadb`; it publishes loopback :3306 and creates the
# aistudio_test database the test suite uses. DB_PASSWORD must match
# MARIADB_PASSWORD in the repo-root .env (the stack creates the user with it).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=aistudio
DB_PASSWORD=aistudio
DB_NAME=aistudio

# Cloudflare Turnstile "I'm not a robot" check for sign-ups (mirrors the
# repo-root .env, which the docker stack reads):
#   off   no check — sign-up works fully offline
#   test  official test keys — the widget works on any domain, every token
#         passes, no Cloudflare account or domain registration needed
#   live  real dashboard keys + a hostname match on the token
# No secret key = off, whatever the mode says.
TURNSTILE_MODE=test
TURNSTILE_SECRET_KEY=
# The widget's public site key, handed to the frontends by GET /auth/config.
# This is the ONE key for the bot check: the app's halves carry no build-time
# key, so a deployment that leaves this empty shows no widget (and sign-ups
# fail the robot check).
TURNSTILE_SITE_KEY=1x0000000000000000000000000000000AA

# Keyless web search behind the agents' web tools (POST /v1/websearch).
#   SEARCH_PROVIDER  auto (default) | searxng | duckduckgo. "auto" prefers the
#                    SearXNG instance when SEARXNG_URL is set, and falls back
#                    to scraping https://html.duckduckgo.com/html/ either way —
#                    no search-provider API key is involved.
#   SEARXNG_URL      Base URL of a SearXNG with the JSON format enabled.
#                    Empty (default) = DuckDuckGo only. In local dev, run one
#                    with: docker compose up -d searxng (it is on the compose
#                    network, so from the host the URL is http://127.0.0.1:8080).
SEARCH_PROVIDER=auto
SEARXNG_URL=
