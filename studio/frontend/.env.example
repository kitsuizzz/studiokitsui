# Copy to .env for local development (gitignored).
#
# The Turnstile site key the sign-up dialog embeds. The official TEST key
# (below) renders on any domain — localhost included — and needs no
# Cloudflare account; pair it with TURNSTILE_MODE=test + the matching test
# secret key in backend/.env. Leave the file out entirely and the app builds
# with no robot check at all. A real deployment passes its own key to the
# image build (see docker-compose.yml) instead.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# The platform gateway the app's server-provided model is called through.
# Default (unset): same-origin "/v1" (nginx in docker, the Vite proxy in dev).
# Point it at the bundled mock provider for the E2E gates/dev without a
# backend — the mock accepts any (or no) key:
VITE_PLATFORM_BASE_URL=http://127.0.0.1:9400/v1

# Optional: pin the default platform model instead of the first /v1/models id.
# VITE_PLATFORM_MODEL=
